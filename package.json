    "preview": "vite preview --port 5191 --host",
    "qa": "node scripts/qa.mjs",
    "qa:breath": "node scripts/physics-qa.mjs",
    "qa:motion": "node scripts/motion.mjs",
    "test": "node scripts/test/slice.test.mjs && node scripts/test/stress.test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@kninnug/constrainautor": "^4.1.0",
    "delaunator": "^5.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
